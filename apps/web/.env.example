# Better Auth / MongoDB
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URL=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# equipora-server (Express backend)
NEXT_PUBLIC_EQUIPORA_SERVER_URL=http://localhost:5000
NEXT_PUBLIC_IMGBB_API_KEY=

# Stripe checkout: publishable key is used in the browser, secret key on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Public frontend URL used for Stripe return URLs.
# Set this to the deployed URL in production (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
